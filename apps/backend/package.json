{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Miami Crime Tracker Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "npm run prisma:deploy && node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "express": "^4.19.2",
    "socket.io": "^4.7.5",
    "bullmq": "^5.15.0",
    "ioredis": "^5.4.1",
    "axios": "^1.7.7",
    "zod": "^3.23.8",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "winston": "^3.14.2",
    "dotenv": "^16.4.5",
    "date-fns": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.14.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
